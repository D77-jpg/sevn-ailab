{
  // 本站是 Next.js 的纯静态导出（next.config.ts → output: "export"），产物在 out/。
  //
  // 这个文件的作用是「告诉 wrangler 只发布静态资源」，必须保留：
  // 没有它时，`wrangler deploy` 会检测到仓库里有 Next.js，自动去跑
  // `npx opennextjs-cloudflare build`（服务端适配器），而静态导出没有
  // Worker 入口，会在 Bundling 阶段失败：
  //   [ERROR] Running custom build `npx opennextjs-cloudflare build` failed.
  // 有 wrangler 配置时不会走那条自动配置路径。
  //
  // 构建机（Cloudflare Workers Builds）设置：
  //   构建命令   npm run build      → 产出 out/
  //   部署命令   npx wrangler deploy → 读本文件，仅上传 out/
  "name": "sevn-ailab",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./out",
    // /about → about.html（与 next.config.ts 的 trailingSlash: false 一致）
    "html_handling": "auto-trailing-slash",
    // 未匹配路径用 out/404.html
    "not_found_handling": "404-page"
  }
}
